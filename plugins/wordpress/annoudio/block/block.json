{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "annoudio/player",
	"version": "0.3.0",
	"title": "Annoudio widget",
	"category": "media",
	"icon": "format-audio",
	"description": "The Annoudio widget: a recording and its community stories, from your Annoudio stack.",
	"keywords": [
		"widget",
		"audio",
		"story",
		"stories",
		"annotation"
	],
	"textdomain": "annoudio",
	"attributes": {
		"recording": {
			"type": "string",
			"default": ""
		},
		"src": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false
	},
	"editorScript": "file:./index.js"
}
