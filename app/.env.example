# Postgres from deploy/docker-compose.dev.yml
DATABASE_URL=postgres://annoudio:annoudio@127.0.0.1:5432/annoudio
# Make a new value with: openssl rand -hex 24
PAYLOAD_SECRET=change-me
# Base of every IRI. Do not change it after the first story.
ANNOUDIO_ORIGIN=http://localhost:3000
# Mail for login codes. A nodemailer connection URL, for example
# smtps://user:password@smtp.example.org:465. Without it, the app writes each
# login code to the server log. Use that in development only.
SMTP_URL=
# The sender of login-code mails, for example "River Voices <stories@example.org>".
EMAIL_FROM=
# The media volume: uploads/, raw/, work/ and derived/. The worker mounts the same
# folder. A relative path is relative to the folder that runs the app.
MEDIA_DIR=./media
# 1 in one process only: it takes the media.settled reports of the worker and sets the
# state of each media body. Leave it empty for `next build` and for the tests.
ANNOUDIO_MEDIA_CONSUMER=1
