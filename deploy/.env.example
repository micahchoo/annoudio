# The settings of one Annoudio stack. Copy this file to deploy/.env, or paste its lines
# into the Environment screen of Dokploy or Coolify. Never commit the real file.
# Make each secret with: openssl rand -hex 32  (or any generator: use letters and digits only).

# --- Required ---------------------------------------------------------------------------

# The password of the database. Letters and digits only, because it goes into a URL.
POSTGRES_PASSWORD=change-me

# The key that signs operator logins and member sessions. Keep it secret. Do not change it: all sessions stop.
PAYLOAD_SECRET=change-me

# The public address of the stack, with https and no path. Every story IRI starts with it. Do not change it after the first story.
ANNOUDIO_ORIGIN=https://stories.example.org

# The mail server, as a nodemailer URL. It sends the login codes, the story mails, the operator digest and the operator password-reset mail. Without it, members cannot sign in.
SMTP_URL=smtps://user:password@smtp.example.org:465

# The sender of all mails, as a name and an address.
EMAIL_FROM="River Voices <stories@example.org>"

# The name shown on the sign-in screen and in the admin header. Default: Annoudio.
# ANNOUDIO_NAME=River Voices

# --- Usually not changed ----------------------------------------------------------------

# The number of reverse proxies in front of the app. The app reads the client IP that many values from the right of X-Forwarded-For. Dokploy or Coolify (Traefik) = 1. Traefik behind Cloudflare = 2.
TRUST_PROXY=1

# The time zone of the 08:00 operator digest, e.g. Asia/Kolkata. The dates that the app writes also use it (default UTC).
# TZ=UTC

# The database URL. Leave it out: the stack makes it from POSTGRES_PASSWORD. Set it only for a database outside the stack.
# DATABASE_URL=postgres://annoudio:PASSWORD@postgres:5432/annoudio

# --- Optional limits. Leave a line out to use the default. Never give an empty value. ---

# The number of stories on one page of a container (default 100).
# STORIES_PAGE_SIZE=100
# The seconds that a browser or a cache can keep a story page (default 60).
# STORIES_MAX_AGE=60
# The most bodies in one story (default 5).
# STORIES_MAX_BODIES=5
# The most tags in one story (default 10).
# STORIES_MAX_TAGS=10
# The most characters in the text of one story (default 5000).
# STORIES_MAX_TEXT=5000
# The most login codes that the whole stack sends in one hour (default 100). Each address can ask for 5 and each IP address for 20.
# ANNOUDIO_CODES_PER_HOUR=100
